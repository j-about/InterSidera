# InterSidera environment. Copy to .env (gitignored).
# `make dev-api` loads the copied `.env` through `uv run --env-file`; from M7 docker compose reads it too.
# Check and test targets never load it, so the test suite stays hermetic.
# SKYAPI_* variables are read by the API only. Never copy one into a VITE_* variable.
# Paths are relative to backend/, the working directory of every backend command.

# Directory holding downloaded data files and caches (host path; compose mounts it as /data).
SKYAPI_DATA_DIR=../data

# Ephemeris file inside DATA_DIR. Code default: de441.bsp (production, ~3.3 GB, -13200..+17191).
# Development and CI use de440s.bsp (~32 MB, 1849..2150).
# Middle tier: de440.bsp (~114 MB, 1550..2650, the range of the Moon orientation kernel); fetch it
# with `sky-data fetch --only de440` and set it here.
SKYAPI_EPHEMERIS=de440s.bsp

# Download missing data files at startup. CI and the test suite set false.
SKYAPI_AUTO_FETCH=true

# uvicorn workers for `fastapi run --workers` (production: number of CPU cores).
SKYAPI_WORKERS=1

# Per-client-IP token bucket on compute endpoints.
SKYAPI_RATE_LIMIT_RPS=20
SKYAPI_RATE_LIMIT_BURST=40
# One bucket table per worker process (`SKYAPI_WORKERS` workers share nothing), so the effective
# limit is per worker. Behind a reverse proxy uvicorn must trust the proxy's address, or every
# client shares the proxy's bucket: `fastapi run --forwarded-allow-ips=<proxy address>` (never
# `*`, which lets any client forge `X-Forwarded-For`) so the bucket key is the real client IP.
# Wired in the compose stack at M7.

# Geocoder advertised to the browser through /meta (the API never calls it).
SKYAPI_GEOCODER_URL=https://nominatim.openstreetmap.org
SKYAPI_GEOCODER_ENABLED=true
# Optional contact e-mail passed as the Nominatim `email` parameter. Empty means unset (any empty
# SKYAPI_ value is ignored and the code default applies).
SKYAPI_GEOCODER_EMAIL=

# Comma-separated list of allowed origins. Production: the app origin only.
SKYAPI_CORS_ORIGINS=https://localhost:5173

# DEBUG | INFO | WARNING | ERROR
SKYAPI_LOG_LEVEL=INFO

# M7 (docker compose): host directory bind-mounted into the api container as DATA_DIR.
# SKY_DATA_DIR=./data
