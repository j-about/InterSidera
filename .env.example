# InterSidera environment. Copy to .env (gitignored).
# `make dev-api` loads the copied `.env` through `uv run --env-file`; `docker compose` reads it for
# the ${...} values of compose.yaml and hands the same file to the api container (env_file).
# Check and test targets never load it, so the test suite stays hermetic.
# SKYAPI_* variables are read by the API only. Never copy one into a VITE_* variable.
# Paths are relative to backend/ for the host-run API; compose paths resolve against the repository
# root.

# Directory holding downloaded data files and caches: the host path of the host-run API. Compose
# mounts SKY_DATA_DIR (below) as /data and sets SKYAPI_DATA_DIR=/data itself.
SKYAPI_DATA_DIR=../data

# Ephemeris file inside DATA_DIR. Code default: de441.bsp (production, ~3.3 GB, -13200..+17191).
# Development and CI use de440s.bsp (~32 MB, 1849..2150).
# Middle tier: de440.bsp (~114 MB, 1550..2650, the range of the Moon orientation kernel); fetch it
# with `sky-data fetch --only de440` and set it here.
SKYAPI_EPHEMERIS=de440s.bsp

# Download missing data files at startup. CI and the test suite set false.
SKYAPI_AUTO_FETCH=true

# uvicorn workers for `fastapi run --workers` (production: number of CPU cores; raise
# SKY_API_MEMORY_LIMIT with it). Never set PORT: `fastapi run` reads it as its port.
SKYAPI_WORKERS=1

# Per-client-IP token bucket on compute endpoints.
SKYAPI_RATE_LIMIT_RPS=20
SKYAPI_RATE_LIMIT_BURST=40
# One bucket table per worker process (`SKYAPI_WORKERS` workers share nothing), so the effective
# limit is per worker. Behind a reverse proxy uvicorn must trust the proxy's address, or every
# client shares the proxy's bucket: `fastapi run --forwarded-allow-ips=<proxy address>` or the
# environment form below, which uvicorn reads when the flag is absent (an address or a network;
# never `*`, which lets any client forge `X-Forwarded-For`), so the bucket key is the real client
# IP. compose.yaml sets FORWARDED_ALLOW_IPS to web's fixed address (10.213.0.3) on the api
# service and wins over this file (never the whole compose network: its gateway relays the host's
# connections and a client could then forge the key); when an external TLS proxy fronts `web`
# from outside the network, append its address there through compose.override.yaml. The line
# below is for a host-run API behind a local proxy.
# FORWARDED_ALLOW_IPS=127.0.0.1

# Geocoder advertised to the browser through /meta (the API never calls it).
SKYAPI_GEOCODER_URL=https://nominatim.openstreetmap.org
SKYAPI_GEOCODER_ENABLED=true
# Optional contact e-mail passed as the Nominatim `email` parameter. Empty means unset (any empty
# SKYAPI_ value is ignored and the code default applies). The address is public by design: /meta
# advertises it and every browser forwards it to Nominatim, so never a private mailbox.
SKYAPI_GEOCODER_EMAIL=

# Comma-separated list of allowed origins. Production: the app origin only (behind nginx the
# browser's API requests are same-origin, so no CORS request happens, but the development origin
# must not ship).
SKYAPI_CORS_ORIGINS=https://localhost:5173

# DEBUG | INFO | WARNING | ERROR
SKYAPI_LOG_LEVEL=INFO

# Web tier: read by `vite dev` and `vite preview` (frontend/vite.config.ts, through Vite's own
# prefix-filtered loader) and rendered into the nginx Content-Security-Policy by the web image's
# entrypoint (compose passes it to the web service); never by the API and never a VITE_* variable
# (nothing here reaches the bundle).

# Origin the browser may reach for the place search: the `connect-src` entry of the
# Content-Security-Policy (frontend/security-headers.ts). Absent means
# https://nominatim.openstreetmap.org. When set it must be a full http(s) origin (scheme, host,
# optional port; no path, trailing slash or query) equal to the origin of SKYAPI_GEOCODER_URL,
# or the policy blocks the geocoder the API advertises (frontend/e2e/csp.spec.ts guards the test
# stack, the release checklist of docs/architecture.md "Deployment" the deployment).
# SKY_GEOCODER_ORIGIN=https://nominatim.openstreetmap.org

# docker compose (compose.yaml; docs/architecture.md "Deployment"). The host directory bind-mounted
# into the api container as /data; it must exist and be writable by SKY_UID:SKY_GID (compose never
# creates it; a clean clone holds data/.gitkeep).
SKY_DATA_DIR=./data
# The uid:gid the api container runs as (the image default is 1000:1000, the development host's).
# SKY_UID=1000
# SKY_GID=1000
# Memory limit of the api container: 1 GB plus 1 GB per worker (a worker serving concurrent
# 100-body frames peaks near 1 GB). compose sets memswap_limit to the same value, so the container
# gets no swap: an anonymous overrun is an OOM kill and a restart, never host swap thrash.
# SKY_API_MEMORY_LIMIT=2G
# Web tier mode: http (the default; also the mode behind an external TLS proxy). compose.tls.yaml
# sets tls itself (nginx terminates TLS with SKY_TLS_DIR/fullchain.pem and privkey.pem, root-owned
# copies; see that file), so leave this line as it is: tls here without the overlay gives web no
# :443 and no certificates, and it restart-loops with `nginx: [emerg] cannot load certificate`.
# SKY_WEB_MODE=http
# SKY_TLS_DIR=./certs
# Outside compose the api image reads WEB_CONCURRENCY (uvicorn's own variable) for its worker count.
# Production: `docker compose run --rm api sky-data fetch` before the first `up` (with
# SKYAPI_EPHEMERIS=de441.bsp: 3.3 GB); SKYAPI_WORKERS = CPU cores; SKYAPI_GEOCODER_EMAIL a public
# contact address; SKY_GEOCODER_ORIGIN equal to the origin of SKYAPI_GEOCODER_URL.
