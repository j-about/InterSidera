# Data directory (DATA_DIR default for development): downloads and caches, never committed.
# Root-anchored: the committed registry and CSV files live in backend/src/skyapi/data/ (ADR-0005).
/data/*
!/data/.gitkeep

# Environment and local overrides
.env
# Local compose overrides (ports, subnet) and the TLS certificates of compose.tls.yaml.
/compose.override.yaml
/certs/
*.local
.claude/settings.local.json

# Python
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.hypothesis/
.coverage
.coverage.*
htmlcov/

# Node / frontend
node_modules/
dist/
# Private e2e-mode builds of parallel agents (`vite build --outDir dist-<x>`).
dist-*/
coverage/
playwright-report/
test-results/
*.tsbuildinfo
.vite/

# Lighthouse and perf reports (make lighthouse, the manual `perf` Playwright project), never committed.
/reports/

# OS
.DS_Store
